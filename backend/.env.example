# ── AI Providers ──────────────────────────────────────────────────────────────
# Groq (free) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Gemini (free) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral (free tier) — https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenRouter (free models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Email Alerts ───────────────────────────────────────────────────────────────
# Resend (free 3k/month) — https://resend.com
RESEND_API_KEY=your_resend_api_key_here
ALERT_EMAIL_TO=you@youragency.com

# ── App ────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Local dev: leave as SQLite. Production: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./ppc_agent.db

# ── Google Ads API ─────────────────────────────────────────────────────────────
# Leave blank to use mock data. Docs: https://developers.google.com/google-ads/api
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
